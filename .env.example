# Neon Postgres (Vercel Marketplace integration) - run `vercel env pull .env` to fill these
# Pooled connection for app queries
NEON_DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require"

# Unpooled/direct connection for migrations
NEON_DATABASE_URL_UNPOOLED="postgresql://[USER]:[PASSWORD]@[HOST].[REGION].aws.neon.tech/neondb?sslmode=require"

# Resend - Email verification
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Email sender (use your verified domain for production)
FROM_EMAIL="Gastrónomos <noreply@yourdomain.com>"

# Public origin used in emails (reset links). Defaults to localhost in dev.
APP_URL="https://gastronomo-web.vercel.app"
